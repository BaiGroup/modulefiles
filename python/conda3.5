#%Module
proc ModulesHelp { } {
        puts stderr "\tThis module provides support for Python."
}

conflict python

set version "3.5"
module-whatis   "Provides Conda Python $version"
set basedir /share/apps/conda/envs/conda$version
prepend-path PATH $basedir/bin
prepend-path LD_LIBRARY_PATH /lib64:/lib:/usr/lib64:/usr/lib:$basedir/lib
prepend-path MANPATH $basedir/share/man
setenv CONDA_PREFIX $basedir
setenv CONDA_DEFAULT_ENV conda$version
