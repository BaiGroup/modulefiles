#%Module
proc ModulesHelp { } {
        puts stderr "\tThis module provides support for Python."
}

conflict python

set version "2.7.8"
module-whatis   "Provides Python $version"
set basedir /share/apps/python-$version
prepend-path PATH $basedir/bin
prepend-path LD_LIBRARY_PATH $basedir/lib
prepend-path MANPATH $basedir/share/man
