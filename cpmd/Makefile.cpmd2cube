#-----------------------------------------------------------------------------#
# Makefile for cpmd2cube.x
# Configuration: Linux-PC-IFORT-FFTW
# Creation of Makefile: Jun 15 2012
# on Linux node1083 2.6.32-220.17.1.el6.x86_64 #1 SMP Wed May 16 00:01:37 BST 2012 x86_64 x86_64 x86_64 GNU/Linux
# Author: baip
# mkdir ~/tools/CPMD-3.13.2/cpmd2cube/build; cd ~/tools/CPMD-3.13.2/cpmd2cube; module load intel/12.1 ompi/1.4.4/intel mkl/10.2.7.041; ./Configure -makefile -DEST=build Linux-PC-IFORT-FFTW; cd build; Modify Makefile; make -j 8
INTEL_INC =/soft/intel/mkl/10.2.7.041/include/fftw
INTEL_LIB =/soft/intel/mkl/10.2.7.041/lib/em64t

#----------------------------------------------------------------------------
#
SHELL = /bin/sh
#
#--------------- Configuration
FC	= ifort
FFLAGS	= -I$(INTEL_INC) -FR -D__IFC -DFFT_FFTW -O3 -msse2 -w90 -w95 -pc64
LFLAGS	= -i-static -O3 -msse2 -pc64 # -w90 -w95
LIBS	= -I$(INTEL_INC) -L$(INTEL_LIB) -lmkl_intel_lp64 -lmkl_core -lmkl_intel_thread -lguide -lpthread -lfftw2xf_intel
# uncomment and set only if needed
#CC	= cc
#CFLAGS	= 
#--------------- End of Configuration
##############

EXE	= cpmd2cube.x

OBJECTS	= \
    kinds.o periodic_table.o util.o grids.o cpmd2cube.o \
    grid_types.o atom_types.o readwrites.o \
    fftsg_lib.o fft_tools.o fftsg.o

CFGDEST = build
CFGMACH = Linux-PC-IFORT-FFTW
SRC=/home/siepmann/baip/tools/CPMD-3.13.2/cpmd2cube

#############################

all:  $(EXE) trimcube cutcube.x

$(EXE): main.o $(OBJECTS)
	 $(FC) -o $(EXE) $(LFLAGS) main.o $(OBJECTS) $(LIBS)

cutcube.x: cutcube.o $(OBJECTS)
	 $(FC) -o $@ $(LFLAGS) cutcube.o $(OBJECTS) $(LIBS)

trimcube: trimcube.o
	$(CC) $(CFLAGS) -o $@ trimcube.o 
#############################
clean:
	rm -f *.o *.mod *.L *~

# Create a new makefile with new dependencies but retain the configuration.
reconfig:
	( cd $(SRC) ; $(SHELL) ./Configure -r -m -SRC=$(SRC) -DEST=$(CFGDEST) $(CFGMACH) ; cd $(CFGDEST) )

#############################
atom_types.o:  $(SRC)/atom_types.F
	$(FC) -c $(FFLAGS) $(SRC)/$*.F

cpmd2cube.o:   $(SRC)/cpmd2cube.F
	$(FC) -c $(FFLAGS) $(SRC)/$*.F

cutcube.o:   $(SRC)/cutcube.F
	$(FC) -c $(FFLAGS) $(SRC)/$*.F

fft_tools.o:   $(SRC)/fft_tools.F
	$(FC) -c $(FFLAGS) $(SRC)/$*.F

grid_types.o:  $(SRC)/grid_types.F
	$(FC) -c $(FFLAGS) $(SRC)/$*.F

grids.o:       $(SRC)/grids.F
	$(FC) -c $(FFLAGS) $(SRC)/$*.F

main.o:        $(SRC)/main.F
	$(FC) -c $(FFLAGS) $(SRC)/$*.F

periodic_table.o: $(SRC)/periodic_table.F
	$(FC) -c $(FFLAGS) $(SRC)/$*.F

readwrites.o:  $(SRC)/readwrites.F
	$(FC) -c $(FFLAGS) $(SRC)/$*.F

util.o:       $(SRC)/util.F
	$(FC) -c $(FFLAGS) $(SRC)/$*.F

kinds.o:      $(SRC)/kinds.F
	$(FC) -c $(FFLAGS) $(SRC)/$*.F

fftsg.o:      $(SRC)/fftsg.F
	$(FC) -c $(FFLAGS) $(SRC)/$*.F

fftsg_lib.o:  $(SRC)/fftsg_lib.F
	$(FC) -c $(FFLAGS) $(SRC)/$*.F

trimcube.o:	$(SRC)/trimcube.c
	$(CC) -c $(CFLAGS) $(SRC)/$*.c

# Dependencies
atom_types.o:  kinds.o \
		periodic_table.o

cpmd2cube.o:   atom_types.o \
		fft_tools.o \
		grid_types.o \
		grids.o \
		kinds.o \
		periodic_table.o \
		readwrites.o \
		util.o

cutcube.o:	kinds.o \
		periodic_table.o

fft_tools.o:   grid_types.o \
		fftsg_lib.o \
		kinds.o

grid_types.o:  kinds.o

grids.o:       grid_types.o \
		kinds.o \
		util.o

main.o:        cpmd2cube.o

periodic_table.o: kinds.o

readwrites.o:  atom_types.o \
		grid_types.o \
		kinds.o

util.o:       kinds.o

