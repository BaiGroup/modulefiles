# Precompiler options
CPP_OPTIONS= -DMPI -DHOST=\"Cori\" -DIFC \
             -DCACHE_SIZE=32000 -DPGF90 -Davoidalloc \
             -DMPI_BLOCK=64000 -DscaLAPACK -Duse_collective \
             -DnoAugXCmeta -Duse_bse_te \
             -Duse_shmem -Dtbdyn -DVTST

CPP        = fpp -f_com=no -free -w0  $*$(FUFFIX) $*$(SUFFIX) $(CPP_OPTIONS)

FC         = ftn
FCL        = ftn -mkl

FREE       = -free -names lowercase

FFLAGS     = -assume byterecl
OFLAG      = -O3 -mtune=haswell -march=haswell -ip
OFLAG_IN   = $(OFLAG)
DEBUG      = -O0 -g -traceback

OBJECTS    = fftmpiw.o fftmpi_map.o fftw3d.o fft3dlib.o \
             $(HOME)/tools/fftw3xf/libfftw3xf_intel.a

INCS       = -I$(MKLROOT)/include/fftw -I$(MKLROOT)/include

LLIBS      = $(MKLROOT)/lib/intel64/libmkl_scalapack_lp64.a -Wl,--start-group $(MKLROOT)/lib/intel64/libmkl_intel_lp64.a $(MKLROOT)/lib/intel64/libmkl_sequential.a $(MKLROOT)/lib/intel64/libmkl_core.a $(MKLROOT)/lib/intel64/libmkl_blacs_intelmpi_lp64.a -Wl,--end-group -lpthread -lm -ldl

OBJECTS_O1 += fft3dfurth.o fftw3d.o fftmpi.o fftmpiw.o
OBJECTS_O2 += fft3dlib.o

# For what used to be vasp.5.lib
CPP_LIB    = $(CPP)
FC_LIB     = $(FC)
CC_LIB     = cc
CFLAGS_LIB = -O
FFLAGS_LIB = -O1
FREE_LIB   = $(FREE)

OBJECTS_LIB= linpack_double.o getshmem.o

# Normally no need to change this
SRCDIR     = ../../src
BINDIR     = ../../bin
