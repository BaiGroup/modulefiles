module add intel/2015/update3; module add impi/5.0.2.044/intel
cd ~/tools/lammps-git/lib/reax; make -f Makefile.ifort # build Fortran reax library
cd ../../src
# Modify CCFLAGS, LINKFLAGS, FFT_INC, and FFT_LIB in MAKE/Makefile.ompi_icc to add optimizations and point to MKL libraries
# To use FFTW3: set FFT_INC = -DFFT_FFTW3, FFT_LIB = -lfftw3, and do module load fftw/3.3-ompi-double
make yes-opt yes-reax yes-user-intel yes-user-omp yes-user-reaxc
make yes-kspace yes-manybody yes-molecule yes-opt yes-reax yes-replica yes-user-intel yes-user-omp yes-user-reaxc
make ompi_icc -j 16
########################################
mkdir ~/tools/lammps-git/build
cd ~/tools/lammps-git/build
cmake -DCMAKE_CXX_COMPILER=mpiicpc -DCMAKE_C_COMPILER=mpiicc -DCMAKE_Fortran_COMPILER=mpiifort -DCMAKE_CXX_FLAGS='-O3 -xHost -ipo -no-prec-div' -DBUILD_MPI=yes -DBUILD_OMP=yes -DFFT=MKL -DLAMMPS_MEMALIGN=64 -DBUILD_SHARED_LIBS=on -DLAMMPS_EXCEPTIONS=yes -DPKG_PYTHON=on -DPKG_KSPACE=yes -DPKG_MOLECULE=yes -DCMAKE_INSTALL_PREFIX=$HOME/tools/lammps/intel-impi-mkl ../cmake
# cmake -DCMAKE_CXX_COMPILER=mpicxx -DCMAKE_C_COMPILER=mpicc -DCMAKE_Fortran_COMPILER=mpif90 -DCMAKE_CXX_FLAGS='-O3 -mtune=native -march=native -ffast-math -fassociative-math -freciprocal-math -fno-signed-zeros -fno-trapping-math -funroll-loops' -DBUILD_MPI=yes -DBUILD_OMP=yes -DFFT=FFTW3 -DLAMMPS_MEMALIGN=64 -DBUILD_SHARED_LIBS=on -DLAMMPS_EXCEPTIONS=yes -DPKG_PYTHON=on -DPKG_KSPACE=yes -DPKG_MOLECULE=yes -DCMAKE_INSTALL_PREFIX=$HOME/tools/lammps/gcc-mpich2-fftw3 ../cmake
make -j 2
