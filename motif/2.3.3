#%Module
conflict motif

set homedir $::env(HOME)
set basedir $homedir/tools/motif-2.3.5/build

prepend-path PATH $basedir/bin
prepend-path MANPATH $basedir/share/man
prepend-path LD_LIBRARY_PATH $basedir/lib64
prepend-path LIBRARY_PATH $basedir/lib64
prepend-path INCLUDE $basedir/include
prepend-path INCLUDE_PATH $basedir/include
prepend-path C_INCLUDE_PATH $basedir/include
prepend-path CPLUS_INCLUDE_PATH $basedir/include
