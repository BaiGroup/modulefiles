#%Module
proc ModulesHelp { } {
        puts stderr "\tThis module provides support for the"
        puts stderr "\tADF program."
}

conflict adf/2014.5

set version "2014.6"

module-whatis   "Provides ADF $version"
prepend-path PATH /share/apps/adf-2014.06/bin

setenv ADFHOME /share/apps/adf-2014.06
setenv ADFBIN /share/apps/adf-2014.06/bin
setenv ADFRESOURCES /share/apps/adf-2014.06/atomicdata
setenv SCMLICENSE /share/apps/adf-2014.06/license.txt
setenv SCM_TMPDIR /share/$env(USER)/space1
