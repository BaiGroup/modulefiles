#%Module
conflict gmp

set basedir /share/apps/gmp-6.1.1
prepend-path LD_LIBRARY_PATH $basedir/lib
#if using the gmp c++ libraries, they need to be able to find
#the libstdc++ provided by gcc 6.1.0 
prepend-path LD_RUN_PATH $basedir/lib
prepend-path LIBRARY_PATH $basedir/lib
prepend-path CPATH $basedir/include
prepend-path C_INCLUDE_PATH $basedir/include
prepend-path CPLUS_INCLUDE_PATH $basedir/include
prepend-path INCLUDE $basedir/include
prepend-path FPATH $basedir/include
