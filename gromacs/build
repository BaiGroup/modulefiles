cmake -DCMAKE_C_COMPILER=cc -DCMAKE_CXX_COMPILER=CC -DGMX_DOUBLE=ON -DGMX_MPI=ON -DGMX_FFT_LIBRARY=mkl -DGMX_BUILD_SHARED_EXE=off -DCMAKE_INSTALL_PREFIX=/global/homes/b/baip/tools/gromacs-2019.3/intel-double-impi-mkl ..
