mkdir ~/tools/gromacs-4.5.5/build
cd ~/tools/gromacs-4.5.5/build
#module load fftw/3.3-ompi-double
#CC=mpicc CXX=mpiCC FFTW3_ROOT_DIR=/soft/fftw/intel-ompi/3.3-double cmake -DGMX_DOUBLE=ON -DGMX_MPI=ON -DGMX_PREFER_STATIC_LIBS=ON -DCMAKE_INSTALL_PREFIX=/home/siepmann/baip/tools/gromacs-4.5.5/build ..
export MKL=/soft/intel/mkl/10.2.7.041
CC=mpicc CXX=mpiCC cmake -DGMX_DOUBLE=ON -DGMX_MPI=ON -DGMX_THREADS=OFF -DGMX_PREFER_STATIC_LIBS=ON -DCMAKE_INSTALL_PREFIX=/home/siepmann/baip/tools/gromacs-4.5.5/build -DGMX_FFT_LIBRARY=mkl -DMKL_INCLUDE_DIR=${MKL}/include "-DMKL_LIBRARIES=${MKL}/lib/em64t/libmkl_intel_lp64.so;${MKL}/lib/em64t/libmkl_core.so;${MKL}/lib/em64t/libmkl_sequential.so" ..
make install -j 8
