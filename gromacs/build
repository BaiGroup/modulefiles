mkdir ~/tools/gromacs-5.0.4/build
cd ~/tools/gromacs-5.0.4/build
# intel-impi-mkl
module add intel/2013/update2 impi/4.1.1.036/intel mkl/11.1.1.106
cmake -DCMAKE_C_COMPILER=mpiicc -DCMAKE_CXX_COMPILER=mpiicpc -DGMX_DOUBLE=ON -DGMX_MPI=ON -DGMX_FFT_LIBRARY=mkl -DCMAKE_INSTALL_PREFIX=/home/siepmann/baip/tools/gromacs-5.0.4/build ..
# intel-ompi-fftw
module add intel/2013/update2 ompi/1.6.3/intel-2013-update2
cmake -DCMAKE_C_COMPILER=mpiicc -DCMAKE_CXX_COMPILER=mpiicpc -DGMX_DOUBLE=ON -DGMX_MPI=ON -DGMX_FFT_LIBRARY=fftw3 -DGMX_BUILD_OWN_FFTW=ON -DCMAKE_INSTALL_PREFIX=/home/siepmann/baip/tools/gromacs-5.0.4/build ..
# gcc-ompi-fftw-cuda (single-precision only for GPU)
module add gcc/4.8.1 ompi/1.7.2/gnu-4.8.1 cuda/6.0
cmake -DCMAKE_C_COMPILER=mpiicc -DCMAKE_CXX_COMPILER=mpicpc -DGMX_MPI=ON -DGMX_GPU=on -DGMX_FFT_LIBRARY=fftw3 -DGMX_BUILD_OWN_FFTW=ON -DCMAKE_INSTALL_PREFIX=/home/siepmann/baip/tools/gromacs-5.0.4/build ..
make -j 16 install
########################################
mkdir ~/tools/gromacs-2016.1/build
