#%Module
proc ModulesHelp { } {
        puts stderr "\tThis module provides support for PHP."
}

conflict php

set version "5.6.22"
module-whatis   "Provides PHP $version"
set homedir $::env(HOME)
set basedir $homedir/tools/php-$version/build
prepend-path PATH $basedir/bin
prepend-path LD_LIBRARY_PATH $basedir/lib
prepend-path MANPATH $basedir/php/man
